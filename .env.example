# MyDesk 环境变量示例：只填你自己的，不要把真实 Key 提交到仓库。
# 本文件不含任何真实凭证，.env 本身已被 .gitignore 忽略。

# 数据库（SQLite，本地文件）
DATABASE_URL="file:./prisma/db/custom.db"

# AI 模型（服务端任务如 aipick 走这里；页面里的 AI 对话走浏览器里配的 Key）
LLM_BASE_URL="https://你自己的模型网关地址/v1"
LLM_MODEL_NAME="你自己的模型名"
LLM_API_KEY="你自己的 Key"

# 港股 / 美股（Longbridge MCP，OAuth；没有就不填，港美功能会如实标未取到）
LONGBRIDGE_MCP_URL=""
LONGBRIDGE_MCP_TOKEN=""
LONGBRIDGE_MCP_REFRESH_TOKEN=""
LONGBRIDGE_MCP_CLIENT_ID=""
LONGBRIDGE_MCP_TOKEN_EXPIRES_AT=""

# 中国股票 MCP（选股用金融 / 估值 / 市值 / 资金流；没有就不填）
CHINA_STOCK_MCP_URL=""

# 调度器开关（生产看门狗拉起时用）
DESK_SCHEDULER="0"
