# 不锚定就会连任意层级的同名目录一起忽略——P6-B 的 src/app/api/events/interpret/prompt/route.ts
# 曾被整条吞掉（`git add` 静默跳过，克隆出来就没有这个接口），所以写成 /test、/prompt。
/test
/prompt

server.log
# Skills directory
/skills
data/quant-config.json
# 人工核对快照：批量IC接口响应的 curl 存盘件（正式测试历史=factor_test 库表；verified 真源=data/factor-verified.json，勿一并忽略）
data/factor-verify-report*.json

# 视觉选型稿：4 套风格页全部是手写死的示例数据、src/ 无引用（见 eltdx-验证-实时与五档.md §设计稿 与 worklog 判定），非项目正式资产
# 仅排除入库，文件保留在磁盘；需要正式收录时用 git add -f
design-mockups/

# P5 生命周期清理的运行时导出目录（每次真实清理写出的 JSON 快照，可能含大量明细行；导出逻辑不变，只是不入版本库）
data/lifecycle/

# ---- R21 仓库卫生：临时探测/调试产物（一次性的上游抓包与探针输出，非项目资产）----
data/_probe-*.json
data/_probe-*.txt
data/_ep.json
mcp-codes.tmp.json
mcp-tools.json

# 本地开发服务器日志（每次启动覆写，不入库）
.devserver.log

# 数据库备份（本地快照，体积大且每次不同）
prisma/db/*.bak-*

# 工作台/助手运行时目录（会话与记忆，属于本机状态）
/.box-agent/
/.workbuddy/

# Windows 保留名文件（cmd 误建，删不掉也无害）
/NUL

# 旧 .next 编译产物的暂存处（rename 移走、暂不删除）
/.stale-next/

# SQLite 运行库：自动增长的二进制，不该进 git（2026-09-29）
prisma/db/*.db
db/*.db
