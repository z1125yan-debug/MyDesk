// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Quant Research Lab（Phase 1 起追加模型；只增不改，不动上方 User/Post）
// 复杂结果一律以 JSON 字符串存放在 *JSON 字段，SQLite 单机即可。
// ============================================================

// 因子库：insert-only 版本化，(factorKey, version) 唯一，禁止覆盖旧版本
model QuantFactor {
  id         String   @id @default(cuid())
  factorKey  String // 稳定因子标识（如 mom_20）
  version    Int // 从 1 递增
  name       String
  category   String // Price|Volume|Momentum|Trend|Reversal|Volatility|Fundamental|Microstructure|AI_Discovered
  expression String // 序列化表达式（DSL 字符串）
  params     String   @default("{}") // JSON
  dataSource String   @default("em") // em|demo|...
  dataRange  String   @default("") // 如 2025-01-01~2026-09-18
  metrics    String   @default("{}") // JSON: ic/rankIc/icIr/groupReturn/longShortReturn/turnover/stability/decay/correlation...
  status     String   @default("Candidate") // Candidate|Validated|Paper|Live|Degraded|Retired
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([factorKey, version])
  @@map("quant_factors")
}

// 策略库：同样版本化
model QuantStrategy {
  id            String   @id @default(cuid())
  strategyKey   String
  version       Int
  name          String
  kind          String   @default("multi_factor") // rule|factor|multi_factor|combo
  factorRefs    String   @default("[]") // JSON [{factorKey,version,weight,direction}]
  selection     String   @default("{}") // JSON 选股参数（股票池/过滤/评分/topN）
  backtest      String   @default("{}") // JSON 回测参数
  metrics       String   @default("{}") // JSON 绩效
  status        String   @default("Candidate") // Candidate|Research|Validated|Paper|Live|Monitoring|Degraded|Retired
  note          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([strategyKey, version])
  @@map("quant_strategies")
}

// 实验跟踪：fingerprint 唯一，避免重复执行完全相同的实验
model QuantExperiment {
  id                 String   @id @default(cuid())
  fingerprint        String   @unique
  kind               String   @default("backtest") // mining|validation|backtest|selection_replay|research
  startedAt          DateTime @default(now())
  dataRange          String   @default("")
  stockPool          String   @default("{}") // JSON
  factorVersions     String   @default("") // key@v 逗号分隔
  strategyVersion    String   @default("")
  parameters         String   @default("{}") // JSON
  backtestParameters String   @default("{}") // JSON
  transactionCost    String   @default("{}") // JSON
  status             String   @default("running") // running|done|failed
  result             String   @default("") // JSON 结果摘要
  failureReason      String   @default("")
  agentConclusion    String   @default("")
  jobId              String   @default("")

  @@map("quant_experiments")
}

// 研究知识库
model QuantKnowledge {
  id        String   @id @default(cuid())
  kind      String // valid_factor|invalid_factor|tested_param|failed_strategy|retired_strategy|experiment_note|market_env|current_strategy
  title     String
  content   String   @default("")
  refs      String   @default("[]") // JSON 关联对象 id
  tags      String   @default("[]") // JSON
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quant_knowledge")
}

// 长任务运行记录（内存为主，落库为快照/审计）
model QuantJob {
  id          String   @id
  kind        String
  fingerprint String   @default("")
  status      String   @default("queued") // queued|running|paused|done|failed|cancelled
  progress    Int      @default(0)
  stage       String   @default("")
  message     String   @default("")
  error       String   @default("")
  payload     String   @default("{}") // JSON
  checkpoint  String   @default("{}") // JSON 断点（恢复用）
  result      String   @default("") // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, status])
  @@map("quant_jobs")
}

// 候选池冻结（P1-1：冻结后 rows 永不覆盖，verify 次日回填）
model CandidatePool {
  poolId     String   @id
  createdAt  DateTime @default(now())
  asOf       String
  universe   String
  conditions String   @default("{}") // JSON
  source     String   @default("")
  dataSource String   @default("") // 数据来源口径（如 em（腾讯/东财…）；旧池为空=未记录）
  rows       String   @default("[]") // JSON（冻结后永不覆盖）
  verify     String?  // JSON（次日验证回填，可重算覆盖）

  @@map("candidate_pool")
}

// 因子有效性测试（P1-4）：每次测试一条记录可追溯；verified 状态取最新一次 passed
model FactorTest {
  id             String   @id @default(cuid())
  factorKey      String
  horizon        Int      @default(5)
  universe       String   @default("all_a_top")
  dataRange      String   @default("") // 实际统计区间 2024-xx-xx~2026-09-xx
  sampleStocks   Int      @default(0)
  sampleDates    Int      @default(0)
  ic             Float    @default(0)
  rankIc         Float    @default(0)
  icIr           Float    @default(0)
  monotonicity   Float    @default(0)
  turnover       Float    @default(0)
  monthlyWinRate Float    @default(0)
  maxDrawdown    Float    @default(0)
  groupReturns   String   @default("[]") // JSON 5档分层年化
  monthlyIc      String   @default("[]") // JSON 逐月 RankIC
  passed         Boolean  @default(false)
  note           String   @default("")
  createdAt      DateTime @default(now())

  @@index([factorKey, createdAt])
  @@map("factor_test")
}

// P2-4 AI 主动发现 / 市场雷达（按交易日落库）
// 幂等策略（P2 定稿）：同一交易日重扫 = 先 deleteMany({asOf: 当日}) 再整批 createMany，读回即为当日全集；
// 跨交易日历史行不触碰。故刻意不设唯一键——当日唯一性由「先删后插」保证，
// 该不变式由 tests/quant/p2-archive-db.test.ts 断言（同日不得出现 (asOf,kind,title) 重复行）。
model RadarFinding {
  id        String   @id @default(cuid())
  asOf      String
  kind      String // risk | theme | fund | news | anomaly
  title     String
  detail    String   @default("")
  evidence  String   @default("{}") // JSON
  // P3 增量扫描：dedupeKey = 当日内的稳定自然键（kind + 标的/事件标识 + 标题），
  // contentHash = detail+evidence 的内容指纹；两者相同 ⇒ 本次与上次是同一条，不重写（不重复落库的实现点）。
  // state：live=本次仍算得出的结论；superseded=当日更早扫描写过、但本次按原公式已不再产出的信号。
  //        只改标记不物理删除，当日 GET/页面只读 live，历史留给第四阶段复盘（不得抹掉当天真实曾出现的信号）。
  dedupeKey String   @default("")
  contentHash String @default("")
  state     String   @default("live")
  createdAt DateTime @default(now())

  @@index([asOf, kind])
  @@index([asOf, dedupeKey])
  @@map("radar_finding")
}

// P2-5 全球事件雷达（按交易日落库，幂等策略同上：当日先删后插，跨日历史不触碰）
model GlobalEvent {
  id            String   @id @default(cuid())
  asOf          String
  title         String
  time          String   @default("")
  level         String // 普通新闻 | 行业新闻 | 重要行业事件 | 重大产业事件 | 全球级事件
  category      String   @default("")
  mappedSectors String   @default("[]") // JSON
  relatedStocks String   @default("[]") // JSON
  fundCheck     String   @default("{}") // JSON
  stage         String   @default("")
  source        String   @default("")
  // P3 增量扫描：快讯没有 id，用「时间 + 标题」指纹当自然键（见 screener/incremental-core.ts eventNaturalKey）。
  // contentHash 覆盖映射结果与资金验证内容：同一条快讯在资金验证结论变化时走更新，而不是再插一行。
  // 注意：事件表不做 supersede —— 上游窗口是滚动的「最近 N 条」，老消息滑出窗口不代表它错了，
  //       按雷达那样标记消失会把真实入库过的事件抹掉，属于丢历史。
  dedupeKey     String   @default("")
  contentHash   String   @default("")
  createdAt     DateTime @default(now())

  @@index([asOf])
  @@index([asOf, dedupeKey])
  @@map("global_event")
}

// P6-B AI 事件理解：对「已经落库的真实事件」加一层解释。事件只有一份，仍在 global_event；
// 这张表存的不是事实，是 AI 对某一条事实事件的解释（data_status 永远是 AI_INTERPRETATION）。
// 自然键用事件行的 dedupeKey（时间+标题指纹）而不是 cuid：全量扫描是「当日先删后插」，
// 同一条快讯重扫后 cuid 会变，用 dedupeKey 才能让解释在重扫之后仍然指向同一条事件。
// 落库前必须过 event-interpret-core 的校验（见 screener/event-interpret.ts）：
// AI 发明的事件 id、无出处的证据/标的、AI 自己生成的概率，都在校验阶段被剔除并留档，不进这张表。
// 保留期：不在 P5 生命周期（180 天）清理范围内——是否跟着事件行一起清理属于用户决定，未定口径前不删。
model EventInterpretation {
  id            String   @id @default(cuid())
  eventKey      String   @unique // global_event.dedupeKey（旧行没有自然键时退回该行 id）
  eventId       String   @default("") // 落库当时对应的 global_event.id：重扫后会变，只用于展示与跳转
  asOf          String // 与 global_event.asOf 同口径（交易日）
  title         String // 事实快照：解释产生时看到的原始标题（事件行被清理后回溯仍能独立成立）
  source        String   @default("")
  publishedAt   String   @default("")
  eventHash     String   @default("") // 当时事件行的 contentHash：与现值不等 ⇒ 解释针对的事件版本已变（stale）
  status        String // INTERPRETED | PARTIAL | REJECTED
  model         String   @default("") // 是哪个模型产出的（客户端配置，不落 Key）
  promptVersion String   @default("")
  violations    String   @default("[]") // JSON：校验违规原文，便于直接查「哪条越界了」
  payload       String   @default("{}") // JSON：§九 完整结构（含 evidence / unknowns / dropped 留档）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([asOf])
  @@map("event_interpretation")
}

// P6-C AI Market Research：把「当前市场环境研究报告」存下来，供回看与对比。
// 为什么需要新增这张表（§三十三 要求先说清）：
// - 已有的三张留档表存的是「某个引擎那一次算出的完整响应」（risk/theme/probability 各一页），
//   存的是机器算的东西；这张表存的是「AI 对当天台账的解释 + 当时那份台账本身」，两者不能互相替代：
//   留档表没有 INTERPRETATION/RISKS/UNKNOWN/NEXT_CHECKS，研究层也不能反过来去改写留档行；
// - event_interpretation 是「一条事件一份解释」，粒度不同：研究层是一份跨源综合，引用的是整批台账行。
// 保存什么：报告 JSON（payload）、生成当时的台账快照（evidence_json，让「这句话从哪来」日后仍可回答）、
//   采集器观测（sources_json）、缺失口径（missing_json）、违规留档（violations）、模型名与提示词版本。
// 不保存什么：不复制行情原始数据、不保存任何 API Key、不保存模型原文之外的东西。
// 生命周期与自然键：reportKey = scope|asOf 唯一 ⇒ 同一范围同一天只有一条，重做就是覆盖（不是堆历史），
//   所以这张表的增长上限就是「天数 × 范围数」，当前只有 market 一个范围 ⇒ 每天最多一行。
// 保留期（§三十四 明确自己的口径，不能偷偷无限增长）：
// - 不进 P5 的 180 天清理：那张表的清理对象是 Radar/Events 归档，扩大它需要用户决定，P6 不擅自改口径；
// - 本表自身的上限由「每天一行 + 覆盖写」保证；行数是否需要按天清理，与 P5 保留天数一样属于用户决定，
//   未定口径前不删任何行（宁可不删，也不多删）。
// 索引：按 asOf 查（页面回看选日期）；reportKey 唯一索引已覆盖 upsert。
model ResearchReport {
  id            String   @id @default(cuid())
  reportKey     String   @unique // scope|asOf（自然键：同一天同范围只留最新一条）
  scope         String   @default("market") // 当前只有 market（个股/板块范围 NOT IMPLEMENTED）
  asOf          String // 北京时间交易日 YYYY-MM-DD
  question      String   @default("") // 人输入的研究问题（原样存，报告离不开问题）
  status        String // INTERPRETED | PARTIAL | REJECTED（服务端复校验后的三态）
  model         String   @default("") // 哪个模型产出的（客户端配置，不落 Key）
  promptVersion String   @default("")
  headline      String   @default("")
  marketPosture String   @default("") // 偏进攻 | 均衡 | 偏防守 | 观察 | 未登记取值：… | 未记录
  evidenceTotal Int      @default(0) // 台账行数（0 ⇒ 报告必然是 REJECTED）
  evidenceJson  String   @default("[]") // JSON：生成当时的服务端台账（含 id/层/出处/asOf/数据状态）
  sourcesJson   String   @default("[]") // JSON：逐采集器观测（ok/empty/failed/not_covered）
  missingJson   String   @default("[]") // JSON：当次缺失口径原文
  violations    String   @default("[]") // JSON：复校验违规（编造引用、无出处数字、概率剥离等）
  payload       String   @default("{}") // JSON：§十三 七层里的 AI 四层 + 引用回填 + dropped 留档
  generatedAt   String   @default("") // 报告生成时刻（北京时间串，与 shanghaiStamp 同口径）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([asOf])
  @@map("research_report")
}

// P2-自动化 后台任务运行记录：用于回答「到底有没有运行 / 什么时候运行 / 为什么失败」
// 幂等口径：同一 (kind, tradeDate) 有 success 就不再重复执行（调度器只认「收盘窗口之后完成」的成功，
// 盘中手动扫描不算收盘结果）；failure 允许重试但每日有限次；已确证休市的当日不再重试（见 scheduler/rules.ts）。
// 服务边界：任务随服务端进程运行，进程未启动时不会执行——记录如实反映这一点，不宣称无人值守。
model TaskRun {
  id         String    @id @default(cuid())
  kind       String // radar | events
  tradeDate  String // 目标交易日 YYYY-MM-DD（北京时间）
  status     String // running（执行中）| success | failure | skipped
  trigger    String    @default("schedule") // schedule=调度器自动 | manual=接口/按钮触发
  startedAt  DateTime
  finishedAt DateTime?
  scanned    Int       @default(0) // 扫描输入条数（快讯/板块等上游返回量）
  results    Int       @default(0) // 实际落库条数
  missing    String    @default("[]") // JSON 数组：本次的数据缺失口径
  error      String    @default("") // failure=异常信息；skipped=机器可读原因 non_trading_day | trading_day_unconfirmed
  basis      String    @default("") // 数据来源/判定依据（如「上证指数当日K线存在=交易日」）
  note       String    @default("")

  @@index([kind, tradeDate])
  @@map("task_run")
}

// P3 增量扫描游标：记录「上次成功扫描推进到哪里」，用于回答「增量凭什么说没漏」。
// 三条硬口径（实现见 screener/incremental-core.ts + screener/incremental.ts）：
// 1) 只有本次数据全部落库成功才写/更新游标 —— 中途失败一律不推进，下次从上次成功位置继续；
// 2) doneKeys 保存的是「已确认在库里的自然键 → 内容指纹」，即使游标被裁剪或进程重启，
//    重复扫描仍会被库内键比对识别为 unchanged，不产生重复行；
// 3) 游标按交易日分行，跨日即视为首次（走原有全量口径），不会拿昨天的游标跳过今天的新数据。
model ScanCursor {
  id         String   @id @default(cuid())
  kind       String // radar | events
  tradeDate  String // 北京时间交易日
  watermark  String   @default("") // 上游数据位置：事件=已处理到的最大快讯时间；雷达=本次候选集合指纹
  doneKeys   String   @default("{}") // JSON：{ 自然键: 内容指纹 }
  unmatched  String   @default("[]") // JSON：已扫过但未命中映射的快讯键（带映射表指纹前缀，映射表变更后自动失效）
  scanned    Int      @default(0) // 上次成功时上游产出条数
  results    Int      @default(0) // 上次成功后库内 live 条数
  basis      String   @default("") // 数据基准说明（来源与口径），供接口/页面如实展示
  note       String   @default("")
  updatedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([kind, tradeDate])
  @@map("scan_cursor")
}

// ===== P5 第五阶段：Risk / Themes / Probability 的每日留档 =====
// 三页此前完全不落库：每次打开页面按当时的真实上游数据现算，关掉就没了 ⇒ 无法回答「上周那天的风险等级是多少」。
// 三张表的共同口径：
// 1) 行内容 = 服务端在留档那一刻调用「页面同源的计算函数」算出来的结果（见 src/app/api/snapshot/*），
//    绝不接受前端把算好的数字 POST 上来入库 —— 那样等于把可伪造的数据写进正式库（REAL_DATA_ONLY）。
// 2) payload 存当次接口完整响应，另把最常回看的几个字段提成列，方便不解析 JSON 也能按天比较。
// 3) 同一天允许多条留档（盘中留一次、收盘后留一次都是真实计算结果），computedAt 记录各次时刻；
//    不做「同日覆盖」：覆盖会把先一次的真实结果抹掉，那正是第三/四阶段反对的做法。
// 4) null / 空数组 = 当时确实算不出来（例如炸板率当日无触板），不以 0 代替；缺失口径随 missing 列一起留档。
// 5) 本阶段只手动「留档今天」，不挂调度器 ⇒ 不存在「每天自动留档」这种说法。
//    这三张表不参与第五阶段的过期清理：用户授权的清理范围只有 radar_finding / global_event 明细行。

model RiskSnapshot {
  id         String  @id @default(cuid())
  tradeDate  String // 北京时间交易日 YYYY-MM-DD
  computedAt String // 留档时刻（北京时间 'YYYY-MM-DD HH:mm:ss'）
  level      String // 正常 | 注意 | 偏高 | 高风险（当次 risk.level）
  total      Int     @default(0) // 参与统计的个股数
  advancers  Int     @default(0)
  decliners  Int     @default(0)
  limitUp    Int     @default(0)
  limitDown  Int     @default(0)
  breakRate  Float? // 炸板率 %；null = 当日触板数为 0 算不出（不以 0 代替）
  mainNetYi  Float   @default(0)
  medianPct  Float   @default(0)
  live       Boolean @default(false) // 计算瞬间是否处于交易时段：留档是当时快照，不冒充收盘值
  payload    String  @default("{}") // 当次 /api/market/risk 的完整响应
  missing    String  @default("[]") // JSON：当次的数据缺失口径
  source     String  @default("") // 数据来源与端点（服务端算的，不是前端传的）

  @@index([tradeDate])
  @@map("risk_snapshot")
}

model ThemeSnapshot {
  id           String  @id @default(cuid())
  tradeDate    String
  computedAt   String
  mainCount    Int     @default(0)
  subCount     Int     @default(0)
  rotationCount Int    @default(0)
  watchCount   Int     @default(0)
  topMain      String  @default("[]") // JSON：主线名+评分，按天比较时不必解析整个 payload
  payload      String  @default("{}")
  missing      String  @default("[]")
  source       String  @default("")

  @@index([tradeDate])
  @@map("theme_snapshot")
}

// 概率页的结果依赖「哪一组筛选条件」，所以留档必须连条件一起存：
// 没有 conditions 的留档行等于一条无法复现、也无法解释的胜率数字，宁可不存。
model ProbabilitySnapshot {
  id         String  @id @default(cuid())
  tradeDate  String // 回放基准日（接口 as_of_trade_date，可能是历史交易日）
  computedAt String // 留档时刻
  tradeDateIsHistorical Boolean @default(false) // 回放基准日早于留档当日（历史回放，不是当日实况）
  scope      String  @default("") // 人类可读口径：标的池 + 回看天数 + 条件条数
  conditions String  @default("[]") // JSON：这次留档用的筛选条件（用户输入，非市场数据）
  universe   String  @default("index")
  lookback   Int     @default(520)
  pooled     String  @default("[]") // JSON：1/5/20 日汇总（胜率/均值/样本数/基准/超额/回撤）
  sampleOk   Boolean @default(false) // 是否有任一期限样本数 ≥30（不足时页面必须提示）
  benchmark  String  @default("") // 基准指数口径
  payload    String  @default("{}")
  missing    String  @default("[]") // JSON：当次的 warnings（含「快照口径条件不参与历史回放」等）
  source     String  @default("")

  @@index([tradeDate])
  @@map("probability_snapshot")
}
// P6-D Agent 自主工具调用：一次「研究运行」的总账 + 逐次工具调用明细。
//
// 为什么要新增这两张表（§三十三 要求先说清，不能默认「Agent 当然要存日志」）：
// - §十八 要能事后回答「刚才调用了什么 / 为什么调用 / 结果是什么 / 有没有 fallback」。
//   这些信息在进程内存里（AgentState.log）只能活到本次请求结束：页面刷新、进程重启、
//   或者用户隔天回看「那次跑出来的结论」时，如果库里没有，问题就只能重跑一遍——
//   而重跑会再打上游，取到的数与当时不同，「当时的结论从哪来」就永久答不上了。
// - 已有的留档表替代不了：risk/theme/probability 三张存的是「某个引擎那一次算出的完整响应」，
//   research_report 存的是「P6-C 那份固定管线报告」——两者都是「服务端自己算」，
//   没有「哪个工具被谁在第几步请求、参数是什么、成没成、退没退兜底」这一层；
//   Agent 的结论引用的是这一层，缺它就等于把结论变成不可解释的黑盒（§十九 明令禁止）。
// - task_run 存的是「调度器跑没跑成」，粒度是「一次扫描」，且没有入参/出处/血缘字段。
//
// 存什么：运行级——问题、实际生效的预算、逐步计数、停止原因、AI 答案原文与服务端复校验结论、
//   台账快照（evidence_json）、缺口原文；调用级——§十八 那 11 项 + 内核为「可核」额外记的字段
//   （kind/data_status/attempt/call_key/cached_from/evidence_id/thought/degraded_from）。
// 不存什么：不存 API Key 与模型配置（凭据始终在客户端，服务端只见过文本）；不复制行情原始数据
//   （payload 只留抽出来的业务主键 refs_json 与一行 summary，整包数据留在它各自的表/上游）；
//   不存任何未被真实调用产生的记录（模型自称调用过而不进 log 的，库里也不会有）。
// 生命周期与自然键：runId 唯一（客户端生成，重复提交同一 runId 是覆盖而不是堆行）；
//   调用行以 (runId, step) 唯一 ⇒ 网络重试把同一步再发一次不会变成两条不同记录。
//   一次运行的行数由预算硬上限天然封顶（tool_call ≤ 24、台账 ≤ 60 行），不会无界增长。
// 保留期（§三十四 要求本层自己说清口径，不偷偷无限增长也不偷偷删）：
// - 不进 P5 的 180 天清理：那张表的清理对象是 radar/event 明细行，把 Agent 日志并进去需要用户决定，
//   P6 不擅自扩大清理口径；
// - 本表只增不改（除 finalize 覆盖答案那几个字段），是否按天/按条数清理与 P5 保留天数一样属用户决定，
//   未定口径前一行都不删（宁可不删，也不多删）。
// 索引：agent_run 按 startedAt 查（页面「最近跑过哪些」）；agent_tool_call 按 runId 整体读，
//   唯一键 (runId, step) 同时服务「按步定位」与幂等写入。
model AgentRun {
  id          String   @id @default(cuid())
  runId       String   @unique // 客户端生成的本次运行 id（页面与日志同一份，不由服务端另编）
  question    String   @default("") // 研究问题原文（空 ⇒ 内核已写明「没有目标」）
  status      String   @default("running") // running | finished（finished 后答案状态看 answerStatus）
  model       String   @default("") // 哪个模型跑的（客户端配置，不落 Key）
  promptVersion String @default("")
  protocolVersion String @default("p6d.agent.v1") // 协议版本：文本内 JSON，不是原生 function-calling
  budgetJson  String   @default("{}") // JSON：normalizeBudget 之后**实际生效**的预算
  budgetNotes String   @default("[]") // JSON：预算被回落/钳制的原因（非法值不许静默接受）
  stateJson   String   @default("{}") // JSON：不可从调用行推导的部分（started_ms / stop / started_at）
  steps       Int      @default(0)
  toolCalls   Int      @default(0)
  evidenceLines Int    @default(0)
  missingLines Int     @default(0)
  cachedHits  Int      @default(0)
  fallbackUsed Int     @default(0)
  latencyTotalMs Int   @default(0)
  logStatusCounts String @default("") // "ok=3,empty=1,..."：§三十九 要按状态统计，落库时就汇总
  evidenceJson String  @default("[]") // JSON：台账行快照（id/层/文本/出处/asOf/分层），回看时不必重算
  answerText  String   @default("") // AI 结论原文（服务端不改写，违规项另存 violations）
  answerCites String   @default("[]") // JSON：模型自称引用的台账行
  answerGaps  String   @default("[]") // JSON：模型自报缺口（含服务端并回的未回应项）
  answerStatus String  @default("") // ACCEPTED | PARTIAL | REJECTED | ""（还没收尾）
  violations  String   @default("[]") // JSON：复校验违规（编造引用、无出处数字、概率剥离等）
  lineageJson String   @default("[]") // JSON：Answer→Evidence→Tool→Source 的血缘行
  missingJson String   @default("[]") // JSON：本次取数缺口原文
  stopReason  String   @default("") // answered | max_steps | max_tool_calls | max_total_ms | retry_limit | no_progress | invalid_directive | ""
  stopDetail  String   @default("")
  basis       String   @default("") // 口径声明（工具集来源、协议说明），页面直接显示
  startedAt   String   @default("") // 北京时间墙钟原文（shanghaiStamp）
  finishedAt  String   @default("")
  elapsedMs   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startedAt])
  @@map("agent_run")
}

// 逐次工具调用：§十八 要求的日志，一次调用一行，字段与内核 ToolCallLogEntry 一一对齐。
// 为什么单独一张表而不是把 JSON 塞进 agent_run：§十八 的问题是「刚才调用了什么」，
// 需要按行筛选/计数（哪个工具失败了几次、每条耗时多少、有没有走兜底），塞成一坨 JSON 就答不了；
// 同时 ToolCallLogEntry 必须能从这张表**完整重建**（summarizeRun 依赖 state.log），所以 19 个字段全部成列。
model AgentToolCall {
  id           String  @id @default(cuid())
  runId        String
  step         Int // 第几步（recordCall 递增；与 runId 一起唯一 ⇒ 重试同一步不产生第二条）
  tool         String // 请求的工具名（登记表里的名字，不改写）
  capability   String // 对应的 P6-A 能力名（工具派生自能力，两边名字同一份）
  executor     String // 实际走的执行器 id；不可执行的工具为空串
  inputJson    String  @default("{}") // JSON：模型请求的入参原文（校验前），「为什么失败」可核
  outputStatus String // §十八：ok|empty|failed|timeout|not_supported|bad_params|budget|cached|rejected|invalid_directive
  kind         String  @default("") // 观测四态（value/real_zero/no_data/request_failed/not_covered），与 outputStatus 正交
  dataStatus   String  @default("") // 分层（REAL/DERIVED/SNAPSHOT/HISTORICAL/AI_INTERPRETATION/DEGRADED/MISSING）
  source       String  @default("") // 这次**实际**取数的源（兜底成功时是兜底源，不是声明源）
  asOf         String  @default("") // 读数时刻（服务端墙钟）；"" 由页面写成「未记录」
  latencyMs    Int? // null = 没计时（没打上游的拒绝调用就是 null，不填 0 冒充跑过）
  error        String  @default("") // 失败/空/不支持的原因原文
  fallbackOf   String  @default("") // 非空 = 因为这条工具失败才换到本条（Tool A failed → Tool B success）
  degradedFrom String  @default("") // 主源失败降级到兜底源时的原文
  attempt      Int      @default(1) // 本工具第几次尝试（含首次）：重试上限的计数在这里
  callKey      String   @default("") // 同参数缓存键（§三十二 重复调用检测）
  cachedFrom   String   @default("") // 命中缓存时指向复用的台账行 id
  evidenceId   String   @default("") // 这次读数进了哪一行台账（"" = 没进，成功但无摘要也留痕）
  thought      String   @default("") // 模型给的调用理由原文（"" = 它没给，页面要如实显示）
  summary      String   @default("") // 进台账的那一行服务端事实句（不是模型的话术）
  notesJson    String   @default("[]") // JSON：采集侧自报补充口径（引擎 missing[] 等），非 §十八 必字段但页面要能看
  refsJson     String   @default("[]") // JSON：从 payload 抽出的业务主键（theme_id/finding_id/event_id/factor_key/…）
  timestamp    String   @default("") // 该次调用的北京时间原文
  createdAt    DateTime @default(now())

  @@unique([runId, step])
  @@index([runId])
  @@map("agent_tool_call")
}

// ===== P15-R2b 逐日宽度沉淀：全A收盘价逐日存档 =====
// 为什么要有这张表：稳智同款监控卡里的「低5日/低3日」「站上5日线占比」要的是**逐日历史**，
// 而快照只有当日价格——库里此前没有任何逐票日线存档。禁造史：不回填、不拿别的东西换算，
// 从部署日起由收盘后调度器（kind=breadth，15:05 后）每天沉淀一行/票，攒够 5 个交易日才出真数。
// 写入口径（实现在 screener/breadth-collect.ts）：
// 1) 只认收盘后（北京 15:05 之后）的全A快照价——盘中价冒充收盘价会把历史钉死成假数，直接拒跑；
// 2) (symbol, tradeDate) 唯一 + 写入侧先查当日已有键再纯插（SQLite 方言没有 skipDuplicates）：同日重跑不重写，收盘价不可变；
// 3) 停牌/无价格（price 缺失或 ≤0）不写行——缺就是缺，宽度统计的分母只数当日真实有行的票；
// 4) 周末拒跑：周六的快照是周五收盘价，拿周六日期入库就是造了个对不上的交易日。
model StockDailyClose {
  id        String   @id @default(cuid())
  symbol    String // 688256.SH
  tradeDate String // 北京时间交易日 YYYY-MM-DD（收盘后沉淀当天）
  close     Float // 收盘价（全A快照当日价格读数）
  name      String   @default("") // 沉淀时名（仅备查；统计只认 symbol+close）
  createdAt DateTime @default(now())

  @@unique([symbol, tradeDate])
  @@index([tradeDate])
  @@map("stock_daily_close")
}
