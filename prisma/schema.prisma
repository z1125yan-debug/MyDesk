// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Quant Research Lab（Phase 1 起追加模型；只增不改，不动上方 User/Post）
// 复杂结果一律以 JSON 字符串存放在 *JSON 字段，SQLite 单机即可。
// ============================================================

// 因子库：insert-only 版本化，(factorKey, version) 唯一，禁止覆盖旧版本
model QuantFactor {
  id         String   @id @default(cuid())
  factorKey  String // 稳定因子标识（如 mom_20）
  version    Int // 从 1 递增
  name       String
  category   String // Price|Volume|Momentum|Trend|Reversal|Volatility|Fundamental|Microstructure|AI_Discovered
  expression String // 序列化表达式（DSL 字符串）
  params     String   @default("{}") // JSON
  dataSource String   @default("em") // em|demo|...
  dataRange  String   @default("") // 如 2025-01-01~2026-09-18
  metrics    String   @default("{}") // JSON: ic/rankIc/icIr/groupReturn/longShortReturn/turnover/stability/decay/correlation...
  status     String   @default("Candidate") // Candidate|Validated|Paper|Live|Degraded|Retired
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([factorKey, version])
  @@map("quant_factors")
}

// 策略库：同样版本化
model QuantStrategy {
  id            String   @id @default(cuid())
  strategyKey   String
  version       Int
  name          String
  kind          String   @default("multi_factor") // rule|factor|multi_factor|combo
  factorRefs    String   @default("[]") // JSON [{factorKey,version,weight,direction}]
  selection     String   @default("{}") // JSON 选股参数（股票池/过滤/评分/topN）
  backtest      String   @default("{}") // JSON 回测参数
  metrics       String   @default("{}") // JSON 绩效
  status        String   @default("Candidate") // Candidate|Research|Validated|Paper|Live|Monitoring|Degraded|Retired
  note          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([strategyKey, version])
  @@map("quant_strategies")
}

// 实验跟踪：fingerprint 唯一，避免重复执行完全相同的实验
model QuantExperiment {
  id                 String   @id @default(cuid())
  fingerprint        String   @unique
  kind               String   @default("backtest") // mining|validation|backtest|selection_replay|research
  startedAt          DateTime @default(now())
  dataRange          String   @default("")
  stockPool          String   @default("{}") // JSON
  factorVersions     String   @default("") // key@v 逗号分隔
  strategyVersion    String   @default("")
  parameters         String   @default("{}") // JSON
  backtestParameters String   @default("{}") // JSON
  transactionCost    String   @default("{}") // JSON
  status             String   @default("running") // running|done|failed
  result             String   @default("") // JSON 结果摘要
  failureReason      String   @default("")
  agentConclusion    String   @default("")
  jobId              String   @default("")

  @@map("quant_experiments")
}

// 研究知识库
model QuantKnowledge {
  id        String   @id @default(cuid())
  kind      String // valid_factor|invalid_factor|tested_param|failed_strategy|retired_strategy|experiment_note|market_env|current_strategy
  title     String
  content   String   @default("")
  refs      String   @default("[]") // JSON 关联对象 id
  tags      String   @default("[]") // JSON
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quant_knowledge")
}

// 长任务运行记录（内存为主，落库为快照/审计）
model QuantJob {
  id          String   @id
  kind        String
  fingerprint String   @default("")
  status      String   @default("queued") // queued|running|paused|done|failed|cancelled
  progress    Int      @default(0)
  stage       String   @default("")
  message     String   @default("")
  error       String   @default("")
  payload     String   @default("{}") // JSON
  checkpoint  String   @default("{}") // JSON 断点（恢复用）
  result      String   @default("") // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, status])
  @@map("quant_jobs")
}

// 候选池冻结（P1-1：冻结后 rows 永不覆盖，verify 次日回填）
model CandidatePool {
  poolId     String   @id
  createdAt  DateTime @default(now())
  asOf       String
  universe   String
  conditions String   @default("{}") // JSON
  source     String   @default("")
  dataSource String   @default("") // 数据来源口径（如 em（腾讯/东财…）；旧池为空=未记录）
  rows       String   @default("[]") // JSON（冻结后永不覆盖）
  verify     String?  // JSON（次日验证回填，可重算覆盖）

  @@map("candidate_pool")
}

// 因子有效性测试（P1-4）：每次测试一条记录可追溯；verified 状态取最新一次 passed
model FactorTest {
  id             String   @id @default(cuid())
  factorKey      String
  horizon        Int      @default(5)
  universe       String   @default("all_a_top")
  dataRange      String   @default("") // 实际统计区间 2024-xx-xx~2026-09-xx
  sampleStocks   Int      @default(0)
  sampleDates    Int      @default(0)
  ic             Float    @default(0)
  rankIc         Float    @default(0)
  icIr           Float    @default(0)
  monotonicity   Float    @default(0)
  turnover       Float    @default(0)
  monthlyWinRate Float    @default(0)
  maxDrawdown    Float    @default(0)
  groupReturns   String   @default("[]") // JSON 5档分层年化
  monthlyIc      String   @default("[]") // JSON 逐月 RankIC
  passed         Boolean  @default(false)
  note           String   @default("")
  createdAt      DateTime @default(now())

  @@index([factorKey, createdAt])
  @@map("factor_test")
}

// P2-4 AI 主动发现 / 市场雷达（按交易日落库）
// 幂等策略（P2 定稿）：同一交易日重扫 = 先 deleteMany({asOf: 当日}) 再整批 createMany，读回即为当日全集；
// 跨交易日历史行不触碰。故刻意不设唯一键——当日唯一性由「先删后插」保证，
// 该不变式由 tests/quant/p2-archive-db.test.ts 断言（同日不得出现 (asOf,kind,title) 重复行）。
model RadarFinding {
  id        String   @id @default(cuid())
  asOf      String
  kind      String // risk | theme | fund | news | anomaly
  title     String
  detail    String   @default("")
  evidence  String   @default("{}") // JSON
  // P3 增量扫描：dedupeKey = 当日内的稳定自然键（kind + 标的/事件标识 + 标题），
  // contentHash = detail+evidence 的内容指纹；两者相同 ⇒ 本次与上次是同一条，不重写（不重复落库的实现点）。
  // state：live=本次仍算得出的结论；superseded=当日更早扫描写过、但本次按原公式已不再产出的信号。
  //        只改标记不物理删除，当日 GET/页面只读 live，历史留给第四阶段复盘（不得抹掉当天真实曾出现的信号）。
  dedupeKey String   @default("")
  contentHash String @default("")
  state     String   @default("live")
  createdAt DateTime @default(now())

  @@index([asOf, kind])
  @@index([asOf, dedupeKey])
  @@map("radar_finding")
}

// P2-5 全球事件雷达（按交易日落库，幂等策略同上：当日先删后插，跨日历史不触碰）
model GlobalEvent {
  id            String   @id @default(cuid())
  asOf          String
  title         String
  time          String   @default("")
  level         String // 普通新闻 | 行业新闻 | 重要行业事件 | 重大产业事件 | 全球级事件
  category      String   @default("")
  mappedSectors String   @default("[]") // JSON
  relatedStocks String   @default("[]") // JSON
  fundCheck     String   @default("{}") // JSON
  stage         String   @default("")
  source        String   @default("")
  // P3 增量扫描：快讯没有 id，用「时间 + 标题」指纹当自然键（见 screener/incremental-core.ts eventNaturalKey）。
  // contentHash 覆盖映射结果与资金验证内容：同一条快讯在资金验证结论变化时走更新，而不是再插一行。
  // 注意：事件表不做 supersede —— 上游窗口是滚动的「最近 N 条」，老消息滑出窗口不代表它错了，
  //       按雷达那样标记消失会把真实入库过的事件抹掉，属于丢历史。
  dedupeKey     String   @default("")
  contentHash   String   @default("")
  createdAt     DateTime @default(now())

  @@index([asOf])
  @@index([asOf, dedupeKey])
  @@map("global_event")
}

// P2-自动化 后台任务运行记录：用于回答「到底有没有运行 / 什么时候运行 / 为什么失败」
// 幂等口径：同一 (kind, tradeDate) 有 success 就不再重复执行（调度器只认「收盘窗口之后完成」的成功，
// 盘中手动扫描不算收盘结果）；failure 允许重试但每日有限次；已确证休市的当日不再重试（见 scheduler/rules.ts）。
// 服务边界：任务随服务端进程运行，进程未启动时不会执行——记录如实反映这一点，不宣称无人值守。
model TaskRun {
  id         String    @id @default(cuid())
  kind       String // radar | events
  tradeDate  String // 目标交易日 YYYY-MM-DD（北京时间）
  status     String // running（执行中）| success | failure | skipped
  trigger    String    @default("schedule") // schedule=调度器自动 | manual=接口/按钮触发
  startedAt  DateTime
  finishedAt DateTime?
  scanned    Int       @default(0) // 扫描输入条数（快讯/板块等上游返回量）
  results    Int       @default(0) // 实际落库条数
  missing    String    @default("[]") // JSON 数组：本次的数据缺失口径
  error      String    @default("") // failure=异常信息；skipped=机器可读原因 non_trading_day | trading_day_unconfirmed
  basis      String    @default("") // 数据来源/判定依据（如「上证指数当日K线存在=交易日」）
  note       String    @default("")

  @@index([kind, tradeDate])
  @@map("task_run")
}

// P3 增量扫描游标：记录「上次成功扫描推进到哪里」，用于回答「增量凭什么说没漏」。
// 三条硬口径（实现见 screener/incremental-core.ts + screener/incremental.ts）：
// 1) 只有本次数据全部落库成功才写/更新游标 —— 中途失败一律不推进，下次从上次成功位置继续；
// 2) doneKeys 保存的是「已确认在库里的自然键 → 内容指纹」，即使游标被裁剪或进程重启，
//    重复扫描仍会被库内键比对识别为 unchanged，不产生重复行；
// 3) 游标按交易日分行，跨日即视为首次（走原有全量口径），不会拿昨天的游标跳过今天的新数据。
model ScanCursor {
  id         String   @id @default(cuid())
  kind       String // radar | events
  tradeDate  String // 北京时间交易日
  watermark  String   @default("") // 上游数据位置：事件=已处理到的最大快讯时间；雷达=本次候选集合指纹
  doneKeys   String   @default("{}") // JSON：{ 自然键: 内容指纹 }
  unmatched  String   @default("[]") // JSON：已扫过但未命中映射的快讯键（带映射表指纹前缀，映射表变更后自动失效）
  scanned    Int      @default(0) // 上次成功时上游产出条数
  results    Int      @default(0) // 上次成功后库内 live 条数
  basis      String   @default("") // 数据基准说明（来源与口径），供接口/页面如实展示
  note       String   @default("")
  updatedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([kind, tradeDate])
  @@map("scan_cursor")
}

// ===== P5 第五阶段：Risk / Themes / Probability 的每日留档 =====
// 三页此前完全不落库：每次打开页面按当时的真实上游数据现算，关掉就没了 ⇒ 无法回答「上周那天的风险等级是多少」。
// 三张表的共同口径：
// 1) 行内容 = 服务端在留档那一刻调用「页面同源的计算函数」算出来的结果（见 src/app/api/snapshot/*），
//    绝不接受前端把算好的数字 POST 上来入库 —— 那样等于把可伪造的数据写进正式库（REAL_DATA_ONLY）。
// 2) payload 存当次接口完整响应，另把最常回看的几个字段提成列，方便不解析 JSON 也能按天比较。
// 3) 同一天允许多条留档（盘中留一次、收盘后留一次都是真实计算结果），computedAt 记录各次时刻；
//    不做「同日覆盖」：覆盖会把先一次的真实结果抹掉，那正是第三/四阶段反对的做法。
// 4) null / 空数组 = 当时确实算不出来（例如炸板率当日无触板），不以 0 代替；缺失口径随 missing 列一起留档。
// 5) 本阶段只手动「留档今天」，不挂调度器 ⇒ 不存在「每天自动留档」这种说法。
//    这三张表不参与第五阶段的过期清理：用户授权的清理范围只有 radar_finding / global_event 明细行。

model RiskSnapshot {
  id         String  @id @default(cuid())
  tradeDate  String // 北京时间交易日 YYYY-MM-DD
  computedAt String // 留档时刻（北京时间 'YYYY-MM-DD HH:mm:ss'）
  level      String // 正常 | 注意 | 偏高 | 高风险（当次 risk.level）
  total      Int     @default(0) // 参与统计的个股数
  advancers  Int     @default(0)
  decliners  Int     @default(0)
  limitUp    Int     @default(0)
  limitDown  Int     @default(0)
  breakRate  Float? // 炸板率 %；null = 当日触板数为 0 算不出（不以 0 代替）
  mainNetYi  Float   @default(0)
  medianPct  Float   @default(0)
  live       Boolean @default(false) // 计算瞬间是否处于交易时段：留档是当时快照，不冒充收盘值
  payload    String  @default("{}") // 当次 /api/market/risk 的完整响应
  missing    String  @default("[]") // JSON：当次的数据缺失口径
  source     String  @default("") // 数据来源与端点（服务端算的，不是前端传的）

  @@index([tradeDate])
  @@map("risk_snapshot")
}

model ThemeSnapshot {
  id           String  @id @default(cuid())
  tradeDate    String
  computedAt   String
  mainCount    Int     @default(0)
  subCount     Int     @default(0)
  rotationCount Int    @default(0)
  watchCount   Int     @default(0)
  topMain      String  @default("[]") // JSON：主线名+评分，按天比较时不必解析整个 payload
  payload      String  @default("{}")
  missing      String  @default("[]")
  source       String  @default("")

  @@index([tradeDate])
  @@map("theme_snapshot")
}

// 概率页的结果依赖「哪一组筛选条件」，所以留档必须连条件一起存：
// 没有 conditions 的留档行等于一条无法复现、也无法解释的胜率数字，宁可不存。
model ProbabilitySnapshot {
  id         String  @id @default(cuid())
  tradeDate  String // 回放基准日（接口 as_of_trade_date，可能是历史交易日）
  computedAt String // 留档时刻
  tradeDateIsHistorical Boolean @default(false) // 回放基准日早于留档当日（历史回放，不是当日实况）
  scope      String  @default("") // 人类可读口径：标的池 + 回看天数 + 条件条数
  conditions String  @default("[]") // JSON：这次留档用的筛选条件（用户输入，非市场数据）
  universe   String  @default("index")
  lookback   Int     @default(520)
  pooled     String  @default("[]") // JSON：1/5/20 日汇总（胜率/均值/样本数/基准/超额/回撤）
  sampleOk   Boolean @default(false) // 是否有任一期限样本数 ≥30（不足时页面必须提示）
  benchmark  String  @default("") // 基准指数口径
  payload    String  @default("{}")
  missing    String  @default("[]") // JSON：当次的 warnings（含「快照口径条件不参与历史回放」等）
  source     String  @default("")

  @@index([tradeDate])
  @@map("probability_snapshot")
}